# No real secrets in this file. Copy to .env on your own machine.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# readonly (default), write, or admin. Invalid values also become readonly.
MUX_ACCESS_MODE=readonly
# Separate Mux token with Video:Write for changes (never use your read token for writes).
MUX_WRITE_TOKEN_ID=
MUX_WRITE_TOKEN_SECRET=
# Further switches; mode=admin and local operator approval also required for deletion.
MUX_ENABLE_ASSET_DELETE=false
MUX_ENABLE_TRACK_DELETE=false
MUX_ENABLE_PLAYBACK_ID_DELETE=false
# Creating PUBLIC playback IDs makes videos more broadly accessible; separately enable.
MUX_ENABLE_PUBLIC_PLAYBACK_ID=false
MUX_REQUEST_TIMEOUT_MS=20000
MUX_MAX_RESPONSE_ITEMS=200
